{
  "expo": {
    "name": "ATOM POS",
    "slug": "atom-pos",
    "version": "1.0.0",
    "scheme": "atom-pos",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-bg.jpg",
      "resizeMode": "cover",
      "backgroundColor": "#00B5A5"
    },
    "android": {
      "package": "com.atompos_k7x2.runable",
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#00B5A5"
      },
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.atompos_k7x2.runable",
      "supportsTablet": true
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "extra": {
      "apiUrl": "http://69.169.97.195:8081/api/",
      "router": {},
      "eas": {
        "projectId": "a1c8b922-52cc-4b26-9e09-60f6df178f91"
      }
    },
    "owner": "tshainoo"
  }
}
